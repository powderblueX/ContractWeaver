# Copy this file to backend/.env. Never commit the real .env file.
# DeepSeek Flash preset. Supply your own key; never put it in frontend VITE_ settings.
# These public values can be changed for another OpenAI-compatible provider.
# The URL is the API base; do not append /chat/completions.
LAW_LLM_API_KEY=
LAW_LLM_BASE_URL=https://api.deepseek.com
LAW_LLM_MODEL=deepseek-flash
# JSON output mode: json_object (default), json_schema, or prompt.
LAW_LLM_JSON_MODE=json_object
LAW_LLM_THINKING_MODE=disabled
# To use provider reasoning: set THINKING_MODE=enabled (if supported).
# Effort is a provider extension; keep provider_default for other compatible APIs.
LAW_LLM_REASONING_EFFORT=provider_default
LAW_LLM_MAX_TOKENS=8192
# Once per structured step on reported reasoning exhaustion; 0 disables. Provider must support this limit.
LAW_LLM_RECOVERY_MAX_TOKENS=32768
LAW_LLM_TEMPERATURE=0.2
LAW_STRUCTURED_OUTPUT_RETRIES=1
LAW_DATABASE_PATH=
LAW_RESOURCES_DIR=
LAW_GENERATED_DIR=
LAW_CORS_ORIGINS=http://localhost:5173
LAW_TOKEN_HOURS=24
LAW_REQUEST_TIMEOUT=120
LAW_MAX_SOURCE_CHARS=60000
LAW_MAX_UPLOAD_BYTES=5242880
LAW_FIELDS_PER_BATCH=10
LAW_AGENT_PARALLELISM=2
# Main agent observes search/review feedback; never approves or exports.
LAW_SUPERVISOR_MAX_SEARCHES=3
LAW_SUPERVISOR_MAX_REPAIRS=1
# Per-operation harness safety budgets, shared by all parallel batches/retries.
LAW_HARNESS_MAX_REQUESTS=512
LAW_HARNESS_MAX_STEPS=512
LAW_HARNESS_TIMEOUT_SECONDS=3600
LAW_HARNESS_MAX_INPUT_CHARS=500000
LAW_COVERAGE_MAX_CONTEXT_CHARS=120000
LAW_RECOMMENDATION_LIMIT=5
LAW_RETRIEVAL_CANDIDATE_POOL=30
LAW_RETRIEVAL_BM25_K1=1.5
LAW_RETRIEVAL_BM25_B=0.75
LAW_RETRIEVAL_RRF_CONSTANT=60
# Optional local embedding model directory for FAISS reranking:
# LAW_EMBEDDING_MODEL_PATH=
